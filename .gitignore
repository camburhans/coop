# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — both real env files must be gitignored, but keep the example templates
.env
.env.*
!.env.example
docker/.env
# the .env.* rule above also matches docker/.env.production.example — re-include
# the committable prod template (it carries no real secrets)
!docker/.env.production.example

# backups & snapshots
/backups
/snapshots

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
