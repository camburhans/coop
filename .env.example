# =============================================================================
# This is the DEVELOPMENT env. The dev app runs on port 3001 against the
# dev Postgres on port 5433. Production uses docker/.env (created in
# Session #5) and must NEVER share a database with dev.
# =============================================================================
#
# Copy this file to .env and fill in real values for local development.

DATABASE_URL="postgresql://coop:devpassword@localhost:5433/coop_dev"
APP_PASSCODE="dev-passcode-change-me"
SESSION_SECRET="dev-secret-at-least-32-characters-long-xxxxx"
AI_API_KEY=""            # optional in Sprint 1 — leave empty
NODE_ENV="development"

# -----------------------------------------------------------------------------
# DB_PASSWORD — PRODUCTION ONLY. Not used by dev.
# -----------------------------------------------------------------------------
# This is consumed exclusively by the PROD compose file (docker/.env) to build
# the prod DATABASE_URL: postgresql://coop:${DB_PASSWORD}@db:5432/coop. Dev does
# NOT use it — dev's DATABASE_URL above is a fixed connection string pointing at
# the localhost:5433 dev Postgres (password "devpassword"). It is documented
# here only to record the variable's shape. Must be at least 16 characters.
# DB_PASSWORD="change-me-to-a-strong-16+-char-secret"

# -----------------------------------------------------------------------------
# BACKUP_DIR — PRODUCTION ONLY. Not used by dev.
# -----------------------------------------------------------------------------
# Absolute path on the host where the nightly prod backups are written. It is
# consumed exclusively by the PROD compose file (docker/.env), which mounts it
# into the backup container as /backups. On the Mac mini, point this at an
# iCloud Drive folder so dumps sync offsite, e.g.
# /Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/coop-backups
# Documented here only to record the variable's shape; set the real value in
# docker/.env (see docker/.env.production.example).
# BACKUP_DIR="/Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/coop-backups"
